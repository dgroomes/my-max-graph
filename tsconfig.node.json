{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "composite": false
  },
  "include": [
    "modules/cli/**/*",
    "modules/diagram/**/*",
    "modules/server/**/*",
    "modules/render/**/*",
    "modules/shared/**/*"
  ]
}
